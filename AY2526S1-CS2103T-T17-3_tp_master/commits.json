4eb50f32677060214b8","isMergeCommit":true,"messageTitle":"Merge pull request #221 from TimothySzu/branch-UpdateUG2","messageBody":"Update help gui width","fileTypesAndContributionMap":{}}]}],"POeticPotatoes":[{"date":"2025-11-03T00:00:00","commitResults":[{"hash":"05b63046ab3fa1cb46d0e4efdf5d6717d0870b40","isMergeCommit":false,"messageTitle":"Allow duplicate persons","messageBody":"Recipients of the same name cannot be added to the address book.\n\nHospitals may deal with patients with identical names, and this\nwould result in an issue.\n\nLet\u0027s identify users uniquely by their name and phone numbers.\n\nDoing so allows children who might not have phone numbers to be\ntagged to their parents\u0027 numbers instead.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":1},"test-code":{"insertions":1,"deletions":1}}},{"hash":"fada8a877cefedec660da6913a6c0497d59ad51e","isMergeCommit":true,"messageTitle":"Merge pull request #212 from POeticPotatoes/bugfix-allow-duplicates","messageBody":"Allow duplicate persons","fileTypesAndContributionMap":{}},{"hash":"a850cdd8219d56a1b083e65281076a46d9bd5bfa","isMergeCommit":false,"messageTitle":"Reformat names to basic whitespace","messageBody":"Names with extra whitespaces are recognised as unique,\neg. \"John Doe\" vs \"John  Doe\".\n\nThis can result in duplicate and invalid names.\n\nLet\u0027s reduce all whitespaces to a single character before checking\nfor duplicate names.\n\nThis also avoids tab and other special space characters.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"410bbe0ef011d7c1fb908a2024aa8b8939f995ab","isMergeCommit":true,"messageTitle":"Merge pull request #213 from POeticPotatoes/bugfix-double-whitespace","messageBody":"Reformat names to basic whitespace","fileTypesAndContributionMap":{}},{"hash":"3f2874a2c6c758dc4256d704301faaead9702daf","isMergeCommit":false,"messageTitle":"Convert all bloodtypes to uppercase","messageBody":"The addressbook recognises and stores lowercase bloodtypes.\n\nThey do not appear during bloodtype searches as it is case sensitive.\n\nLet\u0027s convert all bloodtypes to uppercase during entry to avoid the\nissue.\n\nExisting lowercase bloodtypes in an addressbook will be udpated.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"a423618036bd04e57393b43b7579621407597270","isMergeCommit":true,"messageTitle":"Merge pull request #215 from POeticPotatoes/bugfix-bloodtype-uppercase","messageBody":"Convert all bloodtypes to uppercase","fileTypesAndContributionMap":{}},{"hash":"50e1aeb476c1ebe0852ad2f89e4a64afe42a9943","isMergeCommit":false,"messageTitle":"Fix priority command error format","messageBody":"Priority command is missing whitespaces after command word.\n\nUsers may be confused by the error message and raise issues.\n\nLet\u0027s fix the command format.\n\nAlso included information about valid priority numbers.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":3}}},{"hash":"b0371a032095af8cd1a078985b7f6636b3321b6e","isMergeCommit":true,"messageTitle":"Merge pull request #216 from POeticPotatoes/bugfix-command-description","messageBody":"Fix priority command error format","fileTypesAndContributionMap":{}},{"hash":"8dc59300174818f06fc20d4de44827fdfee2f773","isMergeCommit":false,"messageTitle":"Fix priority error message","messageBody":"Priority command uses error message of persons listing.\n\nThe message it displays is incoherent and has incorrect grammar.\n\nLet\u0027s create a new error message for it that helps the user more.\n\nReferring to priorities as \"list of priorities\" avoids plurality\nissues.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":1}}},{"hash":"fb1d7a2df3803f258e65bdbeef9eb29aec237b8f","isMergeCommit":true,"messageTitle":"Merge pull request #217 from POeticPotatoes/bugfix-priority-error-message","messageBody":"Fix priority error message","fileTypesAndContributionMap":{}},{"hash":"fde0d7ad784f1769dc2ad7406024e848d2342895","isMergeCommit":false,"messageTitle":"Update Developer Guide","messageBody":"Developer Guide is still missing important details like command\nsummary.\n\nThis prevents other developers from adding on to our project.\n\nLet\u0027s add the crucial sections in.\n\nAlso added relevant PUML diagrams.\n","fileTypesAndContributionMap":{"docs":{"insertions":240,"deletions":4}}},{"hash":"b4517370b6471fdeada7e639437f8223849aa3f5","isMergeCommit":true,"messageTitle":"Merge pull request #218 from POeticPotatoes/add-dg-diagrams","messageBody":"Update Developer Guide","fileTypesAndContributionMap":{}}]}],"tch1001":[{"date":"2025-11-02T00:00:00","commitResults":[{"hash":"68009b90bf026f23ebee7ac795729c122cf9fa79","isMergeCommit":false,"messageTitle":"Fixed bt inconsistency with b","messageBody":"This will\n- make the blood type consistent\n- improve user experience\n- save lives\n- improve the world\n- make the world a better place\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":3},"docs":{"insertions":1,"deletions":1},"test-code":{"insertions":5,"deletions":5}}},{"hash":"c7c4d073827402b2e42afac36c4f120a07482c8a","isMergeCommit":false,"messageTitle":"Fixed bloodtype help menu","messageBody":"This commit\n- adds missing space\n- will make it clearer\n- improve UX\n- improve lives\n- save lives\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":1}}},{"hash":"ef0178418028190ad65206d6849e264bd93bf381","isMergeCommit":false,"messageTitle":"Fixed compatible command","messageBody":"In this commit\n- transposed compatibility matrix\n- looking for recipients for a donor\n- prevent catastrophic behaviour\n- saved lives\n- improved UX\n","fileTypesAndContributionMap":{"functional-code":{"insertions":11,"deletions":10}}},{"hash":"297f88d0e60f52c0b83583e60c6801df9125ab03","isMergeCommit":false,"messageTitle":"Fixed combined command","messageBody":"T