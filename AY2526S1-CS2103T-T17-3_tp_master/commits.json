212 from POeticPotatoes/bugfix-allow-duplicates","messageBody":"Allow duplicate persons","fileTypesAndContributionMap":{}},{"hash":"a850cdd8219d56a1b083e65281076a46d9bd5bfa","isMergeCommit":false,"messageTitle":"Reformat names to basic whitespace","messageBody":"Names with extra whitespaces are recognised as unique,\neg. \"John Doe\" vs \"John  Doe\".\n\nThis can result in duplicate and invalid names.\n\nLet\u0027s reduce all whitespaces to a single character before checking\nfor duplicate names.\n\nThis also avoids tab and other special space characters.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"410bbe0ef011d7c1fb908a2024aa8b8939f995ab","isMergeCommit":true,"messageTitle":"Merge pull request #213 from POeticPotatoes/bugfix-double-whitespace","messageBody":"Reformat names to basic whitespace","fileTypesAndContributionMap":{}},{"hash":"3f2874a2c6c758dc4256d704301faaead9702daf","isMergeCommit":false,"messageTitle":"Convert all bloodtypes to uppercase","messageBody":"The addressbook recognises and stores lowercase bloodtypes.\n\nThey do not appear during bloodtype searches as it is case sensitive.\n\nLet\u0027s convert all bloodtypes to uppercase during entry to avoid the\nissue.\n\nExisting lowercase bloodtypes in an addressbook will be udpated.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"a423618036bd04e57393b43b7579621407597270","isMergeCommit":true,"messageTitle":"Merge pull request #215 from POeticPotatoes/bugfix-bloodtype-uppercase","messageBody":"Convert all bloodtypes to uppercase","fileTypesAndContributionMap":{}},{"hash":"50e1aeb476c1ebe0852ad2f89e4a64afe42a9943","isMergeCommit":false,"messageTitle":"Fix priority command error format","messageBody":"Priority command is missing whitespaces after command word.\n\nUsers may be confused by the error message and raise issues.\n\nLet\u0027s fix the command format.\n\nAlso included information about valid priority numbers.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":3}}},{"hash":"b0371a032095af8cd1a078985b7f6636b3321b6e","isMergeCommit":true,"messageTitle":"Merge pull request #216 from POeticPotatoes/bugfix-command-description","messageBody":"Fix priority command error format","fileTypesAndContributionMap":{}},{"hash":"8dc59300174818f06fc20d4de44827fdfee2f773","isMergeCommit":false,"messageTitle":"Fix priority error message","messageBody":"Priority command uses error message of persons listing.\n\nThe message it displays is incoherent and has incorrect grammar.\n\nLet\u0027s create a new error message for it that helps the user more.\n\nReferring to priorities as \"list of priorities\" avoids plurality\nissues.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":1}}},{"hash":"fb1d7a2df3803f258e65bdbeef9eb29aec237b8f","isMergeCommit":true,"messageTitle":"Merge pull request #217 from POeticPotatoes/bugfix-priority-error-message","messageBody":"Fix priority error message","fileTypesAndContributionMap":{}},{"hash":"fde0d7ad784f1769dc2ad7406024e848d2342895","isMergeCommit":false,"messageTitle":"Update Developer Guide","messageBody":"Developer Guide is still missing important details like command\nsummary.\n\nThis prevents other developers from adding on to our project.\n\nLet\u0027s add the crucial sections in.\n\nAlso added relevant PUML diagrams.\n","fileTypesAndContributionMap":{"docs":{"insertions":240,"deletions":4}}},{"hash":"b4517370b6471fdeada7e639437f8223849aa3f5","isMergeCommit":true,"messageTitle":"Merge pull request #218 from POeticPotatoes/add-dg-diagrams","messageBody":"Update Developer Guide","fileTypesAndContributionMap":{}},{"hash":"a2f1cf0b2a8570fb42d355df836ec93d06a9c460","isMergeCommit":false,"messageTitle":"Update excel feature diagrams","messageBody":"The diagrams representing the excel feature are large and repeated.\n\nThey do not contribute useful information for the reader.\n\nLet\u0027s update the diagrams and include a new object diagram.\n\nIt provides a clearer view of how the system works.\n","fileTypesAndContributionMap":{"docs":{"insertions":79,"deletions":45}}},{"hash":"2b80e3b2cd017b4d31a1fc1f25002706092eb742","isMergeCommit":true,"messageTitle":"Merge pull request #223 from POeticPotatoes/branch-update-excel","messageBody":"Update excel feature diagrams","fileTypesAndContributionMap":{}}]},{"date":"2025-11-04T00:00:00","commitResults":[{"hash":"cd0d8e8ac8df3d18b39b91ddb793b148f9b69f78","isMergeCommit":false,"messageTitle":"Update landing page","messageBody":"The landing page still displays AB3 and links to it.\n\nUsers might get confused if they navigate to a different project.\n\nLet\u0027s update the landing page so it makes more sense.\n\nAlso credited AB3 in the acknowledgements section.\n","fileTypesAndContributionMap":{"docs":{"insertions":16,"deletions":16}}},{"hash":"149a3bf7c223e983a12c614a161bab811c14b894","isMergeCommit":true,"messageTitle":"Merge pull request #232 from POeticPotatoes/branch-update-landing","messageBody":"Update landing page","fileTypesAndContributionMap":{}},{"hash":"f15a4a2d582ed21428c395bf22644947f663080c","isMergeCommit":false,"messageTitle":"Fix excel import diagrams","messageBody":"The diagram for the proposed excel feature has an incorrect\nactivation bar.\n\nIt appears as if commands in model are asynchronous.\n\nLet\u0027s fix the activation bar and its wrapping loop.\n\nImproves clarity of program flow as well.\n","fileTypesAndContributionMap":{"docs":{"insertions":13,"deletions":8}}},{"hash":"04ff7bb1841d10aa78a314e091238a63b6d0d1d8","isMergeCommit":true,"messageTitle":"Merge pull request #233 from POeticPotatoes/bugfix-import-diagrams","messageBody":"Fix excel import diagrams","fileTypesAndContributionMap":{}}]}],"tch1001":[{"date":"2025-11-02T00:00:00","commitResults":[{"hash":"68009b90bf026f23ebee7ac795729c122cf9fa79","isMergeCommit":false,"messageTitle":"Fixed bt inconsistency with b","messageBody":"Thi