"gitId":"-"},"content":"     *     - GROUP: alphanumeric only (no spaces, no symbols)","lastModifiedDate":"2025-10-29T15:08:19","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"-"},"content":"     *     - VALUE: alphanumeric + dots, hyphens, underscores (but no spaces)","lastModifiedDate":"2025-10-29T15:08:19","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"-"},"content":"     *     - VALUE must start with alphanumeric, and can contain any combination after","lastModifiedDate":"2025-10-29T15:08:19","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"-"},"content":"     */","lastModifiedDate":"2025-10-29T15:08:19","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"-"},"content":"    public static final String GROUPED_VALIDATION_REGEX \u003d \"^([a-zA-Z0-9]+)\\\\.([a-zA-Z0-9][a-zA-Z0-9.\\\\-_]*)$\";","lastModifiedDate":"2025-10-29T15:08:19","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2016-08-24T16:57:46","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"-"},"content":"    private static final String TAG_GROUP_IDENTIFIER \u003d \".\";","lastModifiedDate":"2025-10-30T00:26:38","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2025-10-30T00:26:38","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"-"},"content":"    public final String tagFormat; // original string","lastModifiedDate":"2025-10-14T23:27:57","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"-"},"content":"    private final TagGroup group; // null if simple tag","lastModifiedDate":"2025-10-14T23:27:57","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"-"},"content":"    private final String value; // either entire tag or value after \".\"","lastModifiedDate":"2025-10-14T23:27:57","isFullCredit":false},{"lineNumber":37,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2016-08-24T16:57:46","isFullCredit":false},{"lineNumber":38,"author":{"gitId":"