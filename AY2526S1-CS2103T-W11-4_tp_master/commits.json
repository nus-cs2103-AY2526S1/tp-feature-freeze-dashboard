18","isMergeCommit":false,"messageTitle":"Update user and developer guide for find by name","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"docs":{"insertions":88,"deletions":9}}},{"hash":"769b2111ba4b8cf3b88a73a2580121e81578c43e","isMergeCommit":false,"messageTitle":"Add planned enhancements","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":27,"deletions":39}}},{"hash":"d4ed1bdfa4a7940ee8b38d8c274cedb04f024535","isMergeCommit":false,"messageTitle":"Improve error message for invalid day and update UG","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"901ebece35b66ce8db57da692b2f80812872ffe4","isMergeCommit":false,"messageTitle":"Remove NFR on code quality","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":6}}},{"hash":"2b1d07a6f6cddd4e54200ba3925cdd92632d27a0","isMergeCommit":false,"messageTitle":"Improve UI for command box","messageBody":"Currently, users need to scroll to view the error messages.\n\nLet\u0027s enable text wrapping so users do not need to scroll horizontally.\n\nThis improves the user experience.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":0}}},{"hash":"112172885081aafd45ddddee18fda506798de6ce","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 of https://github.com/AY2526S1-CS2103T-W11-4/tp into improve-docs","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"50bd0cc366e0d56ed2b8045d92a2b257ae875fcf","isMergeCommit":false,"messageTitle":"Update user guide introduction and formatting","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":65,"deletions":31}}},{"hash":"947b605be9eb59cd7bd160598abcc94a87a600f3","isMergeCommit":false,"messageTitle":"Find command: improve error handling and code quality","messageBody":"The find command silently ignores multiple and duplicate prefix usage\n(e.g., find t/tag s/subject or find t/tag t/tag), making it difficult\nfor users to understand unexpected search behavior.\n\nUsers need clear, actionable error messages that explain what went wrong\nand how to fix it. Additionally, some error messages are scattered\ninline rather than centralized.\n\nLet\u0027s,\n* add validation to reject multiple search prefixes with a clear error\n* add validation to reject duplicate prefix usage with specific guidance\n* centralize find-related error messages in Messages.java\n* optimize FindCommandParser by extracting error Map to class constant\n* update UserGuide to document all find error scenarios with examples\n\nThe Map-based approach for duplicate validation is preferred over\nrepetitive if-statements because it\u0027s more maintainable and follows\nthe DRY principle. Error messages are moved to Messages.java to\nmaintain consistency with the existing codebase structure.\n\nEach search type section in UserGuide now includes relevant error\nexamples immediately after the usage examples, making it easier for\nusers to troubleshoot issues in context.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":39,"deletions":5},"docs":{"insertions":17,"deletions":2}}},{"hash":"cbbe44d5ffab7383f96dbac58b8ff5be6aeee6e6","isMergeCommit":false,"messageTitle":"Update test cases for find command","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":0},"test-code":{"insertions":49,"deletions":0}}},{"hash":"7d275936bdea6ad0756672e42cb6bb43573902e4","isMergeCommit":true,"messageTitle":"Merge pull request #336 from yatihe01/update-UG","messageBody":"Update UG","fileTypesAndContributionMap":{}},{"hash":"a00c211a65c3e605fe14c438165d9026b0117445","isMergeCommit":false,"messageTitle":"Update UML diagrams and documentation","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":202,"deletions":7}}}]},{"date":"2025-11-03T00:00:00","commitResults":[{"hash":"f84dcc89ffc5558804a662e373d3048643cc8404","isMergeCommit":true,"